POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ir_cms
# Runtime connection (pooled on Neon: host contains `-pooler`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ir_cms?schema=public
# Migrations only. Direct/unpooled connection - on Neon this is the same
# host with `-pooler` removed. Locally it can equal DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/ir_cms?schema=public
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=battle-kard-blogs
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=hello@idolrun.com,dev@idolrun.com,marketing@idolrun.com

# --- Translation (Google Cloud Translation, server-only) -------------------
# Never put a service account JSON key here (org policy forbids key creation).
# Local dev: run `gcloud auth application-default login` and set only
# GCP_PROJECT_ID. Production (Vercel): Workload Identity Federation via Vercel
# OIDC - set all of the GCP_* variables below. See docs/translations.md.
GCP_PROJECT_ID=
GCP_TRANSLATE_LOCATION=global
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Shared secret for /api/cron/translations (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Canonical public origin, used for canonical/hreflang/sitemap URLs.
SITE_URL=http://localhost:3000
